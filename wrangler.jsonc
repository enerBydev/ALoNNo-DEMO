{
  "name": "alonno-demo",
  "main": "./.output/server/index.mjs",
  // >= 2024-09-19 o el Worker no sirve los assets estaticos (trampa documentada).
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  // La URL del proyecto NO es una credencial (la credencial es la clave, que va como
  // secret del Worker), asi que se versiona: asi el repo dice contra que base habla.
  "vars": {
    "SUPABASE_URL": "https://qbrgwphcpflbwhfqhffc.supabase.co"
  },
  // El almacen de la cache. Sin el, `defineCachedEventHandler` cae a memoria del proceso — y en
  // Workers cada peticion puede tocar una instancia distinta, asi que la cache no acierta nunca.
  "kv_namespaces": [
    { "binding": "CACHE", "id": "bbb24212ab7644a289a9a3383021ee26" }
  ],

  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public"
  }
}
